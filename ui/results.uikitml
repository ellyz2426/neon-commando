<panel>
  <style>
    #root {
      flex-direction: column;
      align-items: center;
      padding: 20;
      gap: 10;
      background-color: rgba(10, 26, 10, 0.95);
      border-radius: 16;
      border-color: #ff4400;
      border-width: 2;
    }
    #results-title {
      font-size: 26;
      color: #ff4400;
    }
    .results-row {
      font-size: 14;
      color: #00ff88;
    }
    #results-score {
      font-size: 22;
      color: #ffaa00;
    }
    #results-highscore {
      font-size: 14;
      color: #ffcc00;
    }
    .results-btn {
      font-size: 16;
      color: #00ff88;
      background-color: rgba(0, 255, 136, 0.15);
      padding: 8;
      border-radius: 8;
      border-color: #00ff88;
      border-width: 1;
      min-width: 160;
      align-items: center;
      justify-content: center;
      margin-top: 4;
    }
    .btn-row {
      flex-direction: row;
      gap: 12;
      margin-top: 8;
    }
    .stats-group {
      flex-direction: column;
      gap: 4;
      align-items: center;
      margin-top: 6;
    }
  </style>
  <div id="root">
    <div id="results-title">MISSION COMPLETE</div>
    <div id="results-score">Score: 0</div>
    <div id="results-highscore">High Score: 0</div>
    <div class="stats-group">
      <div id="results-wave" class="results-row">Wave Reached: 1</div>
      <div id="results-kills" class="results-row">Enemies Killed: 0</div>
      <div id="results-combo" class="results-row">Best Combo: 0x</div>
      <div id="results-time" class="results-row">Time: 0:00</div>
      <div id="results-rating" class="results-row"></div>
      <div id="results-missions" class="results-row"></div>
      <div id="results-achievements" class="results-row"></div>
      <div id="results-bonus" class="results-row"></div>
      <div id="results-multikill" class="results-row"></div>
    </div>
    <div class="btn-row">
      <div id="btn-retry" class="results-btn">Retry</div>
      <div id="btn-menu" class="results-btn">Menu</div>
    </div>
  </div>
</panel>
