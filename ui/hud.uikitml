<panel>
  <style>
    #root {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 8;
      gap: 12;
      background-color: rgba(10, 26, 10, 0.8);
      border-radius: 8;
      border-color: #00ff88;
      border-width: 1;
    }
    .hud-item {
      font-size: 14;
      color: #00ff88;
    }
    #hud-combo {
      font-size: 16;
      color: #ffaa00;
    }
    #hud-weapon {
      font-size: 12;
      color: #ff8800;
    }
    #hud-shield {
      font-size: 12;
      color: #0088ff;
    }
    #hud-timer {
      font-size: 14;
      color: #ff4444;
    }
    .left-group {
      flex-direction: row;
      gap: 12;
      align-items: center;
    }
    .right-group {
      flex-direction: row;
      gap: 8;
      align-items: center;
    }
    .center-group {
      flex-direction: column;
      align-items: center;
      gap: 2;
    }
  </style>
  <div id="root">
    <div class="left-group">
      <div id="hud-score" class="hud-item">Score: 0</div>
      <div id="hud-wave" class="hud-item">Wave 1</div>
    </div>
    <div class="center-group">
      <div id="hud-combo"></div>
      <div id="hud-weapon"></div>
      <div id="hud-shield"></div>
      <div id="hud-timer"></div>
    </div>
    <div class="right-group">
      <div id="hud-lives" class="hud-item">Lives: 3</div>
      <div id="hud-grenades" class="hud-item">G: 5</div>
    </div>
  </div>
</panel>
